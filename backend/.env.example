# Copy to .env and adjust values for your local Postgres instance.
# Full URL (takes precedence when set):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inventory_pollyspop

# Or set individual parts (used when DATABASE_URL is unset):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory_pollyspop
