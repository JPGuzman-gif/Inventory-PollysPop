# Polly's Pop — environment configuration
# Copy to .env and adjust values:
#   copy .env.example .env
#
# Start PostgreSQL locally (from project root):
#   docker compose up -d

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# schema.sql uses PostgreSQL syntax. PostgreSQL is required for init and runtime.
#
# Common URL forms (all normalized automatically):
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pollyspop

# Optional PostgreSQL pool tuning (ignored for SQLite)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# SQLite is not supported by the current schema.sql. This example is kept for
# future compatibility work only:
# DATABASE_URL=sqlite:///./data/pollyspop.db

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# APP_NAME=Polly's Pop — Production & Inventory
# DEBUG=false
